# Çalışma modu — local (polling, kendi token'ın) | hosted (tek demo)
ENSEMBLE_MODE=local
ENSEMBLE_ALLOW_FAKE_SEED=0

# Hosted public demo sertleştirme (#63) — YALNIZ hosted demo'da doldurulur;
# local/dev'de BOŞ bırak (DEMO_MODE=false varsayılan, davranış hiç değişmez).
# Açılışta fail-closed: DEMO_MODE=true iken GITHUB_REPO_OWNER/NAME zorunlu.
DEMO_MODE=false
DEMO_RATE_WINDOW_S=60
DEMO_AI_RATE_LIMIT=10
DEMO_AI_GLOBAL_LIMIT=60
DEMO_RATE_LIMIT=120
DEMO_CACHE_TTL_S=900
DEMO_CACHE_MAX_ENTRIES=1024

# AI saglayicisi ENSEMBLE_MODE'dan bagimsiz: gemini | ollama
LLM_PROVIDER=gemini

# Hosted platform secret seti (#186 — S3 go-live boşluk analizi; T-192
# self-host dönüşümüyle güncellendi, D-46): bunların hepsi sunucudaki
# `/etc/ensemble/ensemble.env` dosyasına yazılmalı (docker compose'un
# `env_file:` alanıyla okunur; GitHub'a hiç girmez, CI secret DEĞİL — bkz.
# aşağıda):
#   GEMINI_API_KEY · GITHUB_APP_ID · GITHUB_APP_INSTALLATION_ID ·
#   GITHUB_APP_PRIVATE_KEY (bkz. aşağıda — dosya-yolu değil, PEM içeriği) ·
#   GITHUB_WEBHOOK_SECRET · DATABASE_URL · CORS_ORIGINS

# CI secret'ları — main->self-host otomatik deploy (#192, T-192,
# .github/workflows/deploy.yml) HİÇBİR CI secret'ı GEREKTİRMEZ (prod sırları
# sunucudaki /etc/ensemble/ensemble.env dosyasında yaşar, GitHub'a hiç
# girmez). CD kapısı bir repo VARIABLE'ı (secret DEĞİL):
#   gh variable set DEPLOY_ENABLED --repo FatihErenCetin/grup54 --body true
# Operatör sunucu kurulumunu (runner Idle) bitirdikten SONRA set edilir —
# kill-switch olarak `--body false` ile CD 5 saniyede kapanır.
#   Eşlemenin kanonik kaynağı: docs/sprint3-kontratlar.md Ek A

# Gemini (embeddings + judge)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq: judge icin YEDEK saglayici (#255) — OPSIYONEL ---
# Bos birakilirsa hicbir sey degismez; doldurulursa judge
# FallbackJudge(Gemini, Groq) ile sarilir: Gemini birincil kalir, Groq
# YALNIZCA Gemini hicbir yargi uretemedigi anda devreye girer.
#
# Neden gerekli (olculen, 2026-07-26 canli sunucu):
#   gemini-2.5-flash       -> 20 istek/GUN   (GenerateRequestsPerDay...FreeTier)
#   gemini-2.5-flash-lite  -> 10 istek/DAKIKA (GenerateRequestsPerMinute...)
# Tek soguk /radar cagrisi 131 judge istegi yapiyor.
#
# Anahtar: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Judge asamasi esszamanliligi (#254). SAGLAYICININ RPM tavanina gore ayarla:
# paralellik tavanin uzerinde yalnizca 429 uretir. 1 = tamamen sirali.
RADAR_JUDGE_CONCURRENCY=8
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_S=10
GEMINI_MAX_RETRIES=3

# Ollama tam-yerel modu (#78). Once modelleri yerelde hazirla:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_TIMEOUT_S=60
OLLAMA_MAX_RETRIES=2

# GitHub App (machine auth — ingest)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Hosted alternatifi (#186; T-192 self-host, D-46) — sunucu env dosyası da
# dosya değil env-string tutar (ayrı secret-mount/rotasyon yönetimi yok);
# PATH boşsa bu alan (PEM içeriği, ham metin) kullanılır. İkisi de boşsa
# mevcut graceful degradasyon (FakeGitHubAdapter) devreye girer.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DEFAULT_BRANCH=main
GITHUB_BACKFILL_LIMIT=50
# Webhook (kayıtta aktif; canlı alıcı S3 #62 — geçici hedef smee kanalı, D-35)
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PROXY_URL=

# Radar eşikleri (#151, kalibre: #18) — 0.0/0.0 kalibrasyon SONUCU, placeholder
# değil: sweep (#29, eval/sweep_results.json) 60 kombinasyonun hiçbirinde FP
# eklemeden recall kazandırmıyor — mevcut korpuste FP'yi engelleyen gate/judge
# katmanı, jaccard/similarity değil. Detay + şerhler: eval/kalibrasyon-raporu.md
RADAR_WINDOW_DAYS=14
RADAR_MIN_JACCARD=0.0
RADAR_MIN_SIMILARITY=0.0

# Store (local: sqlite dosya yolu · hosted: postgres dsn)
DATABASE_URL=

# Frontend (Vite) — backend base URL
VITE_API_BASE_URL=http://localhost:8000
# Mock modu (#21) — yalnız "1" kabul edilir: frontend fixture verisiyle çalışır
# (UI'da "Örnek veri" rozeti görünür); başka değer açılışta net hata verir
VITE_MOCK=

# CORS allowlist (virgüllü, #45) — asla "*". Boş bırakma; set etmezsen local
# varsayılanları geçerli: http://localhost:5173 + http://127.0.0.1:5173
# Hosted örneği:
# CORS_ORIGINS=https://ensemble-demo.vercel.app
