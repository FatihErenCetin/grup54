# Çalışma modu — local (polling, kendi token'ın) | hosted (tek demo)
ENSEMBLE_MODE=local
ENSEMBLE_ALLOW_FAKE_SEED=0

# Hosted public demo sertleştirme (#63) — YALNIZ hosted demo'da doldurulur;
# local/dev'de BOŞ bırak (DEMO_MODE=false varsayılan, davranış hiç değişmez).
# Açılışta fail-closed: DEMO_MODE=true iken GITHUB_REPO_OWNER/NAME zorunlu.
DEMO_MODE=false
DEMO_RATE_WINDOW_S=60
DEMO_AI_RATE_LIMIT=10
DEMO_AI_GLOBAL_LIMIT=60
DEMO_RATE_LIMIT=120
DEMO_CACHE_TTL_S=900
DEMO_CACHE_MAX_ENTRIES=1024

# AI saglayicisi ENSEMBLE_MODE'dan bagimsiz: gemini | ollama
LLM_PROVIDER=gemini

# Hosted platform secret seti (#186 — S3 go-live boşluk analizi; T-192
# self-host dönüşümüyle güncellendi, D-46): bunların hepsi sunucudaki
# `/etc/ensemble/ensemble.env` dosyasına yazılmalı (docker compose'un
# `env_file:` alanıyla okunur; GitHub'a hiç girmez, CI secret DEĞİL — bkz.
# aşağıda):
#   GEMINI_API_KEY · GITHUB_APP_ID · GITHUB_APP_INSTALLATION_ID ·
#   GITHUB_APP_PRIVATE_KEY (bkz. aşağıda — dosya-yolu değil, PEM içeriği) ·
#   GITHUB_WEBHOOK_SECRET · DATABASE_URL · CORS_ORIGINS

# CI secret'ları — main->self-host otomatik deploy (#192, T-192,
# .github/workflows/deploy.yml) HİÇBİR CI secret'ı GEREKTİRMEZ (prod sırları
# sunucudaki /etc/ensemble/ensemble.env dosyasında yaşar, GitHub'a hiç
# girmez). CD kapısı bir repo VARIABLE'ı (secret DEĞİL):
#   gh variable set DEPLOY_ENABLED --repo FatihErenCetin/grup54 --body true
# Operatör sunucu kurulumunu (runner Idle) bitirdikten SONRA set edilir —
# kill-switch olarak `--body false` ile CD 5 saniyede kapanır.
#   Eşlemenin kanonik kaynağı: docs/sprint3-kontratlar.md Ek A

# Gemini (embeddings + judge)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq: judge icin YEDEK saglayici (#255) — OPSIYONEL ---
# Bos birakilirsa hicbir sey degismez; doldurulursa judge
# FallbackJudge(Gemini, Groq) ile sarilir: Gemini birincil kalir, Groq
# YALNIZCA Gemini hicbir yargi uretemedigi anda devreye girer.
#
# Neden gerekli (olculen, 2026-07-26 canli sunucu):
#   gemini-2.5-flash       -> 20 istek/GUN   (GenerateRequestsPerDay...FreeTier)
#   gemini-2.5-flash-lite  -> 10 istek/DAKIKA (GenerateRequestsPerMinute...)
# Tek soguk /radar cagrisi 131 judge istegi yapiyor.
#
# Anahtar: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Judge asamasi esszamanliligi (#254). SAGLAYICININ RPM tavanina gore ayarla:
# paralellik tavanin uzerinde yalnizca 429 uretir. 1 = tamamen sirali.
RADAR_JUDGE_CONCURRENCY=8
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_S=10
GEMINI_MAX_RETRIES=3

# Ollama tam-yerel modu (#78). Once modelleri yerelde hazirla:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_TIMEOUT_S=60
OLLAMA_MAX_RETRIES=2

# GitHub App (machine auth — ingest)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Hosted alternatifi (#186; T-192 self-host, D-46) — sunucu env dosyası da
# dosya değil env-string tutar (ayrı secret-mount/rotasyon yönetimi yok);
# PATH boşsa bu alan (PEM içeriği, ham metin) kullanılır. İkisi de boşsa
# mevcut graceful degradasyon (FakeGitHubAdapter) devreye girer.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DEFAULT_BRANCH=main
GITHUB_BACKFILL_LIMIT=50
# RADAR'in ilk doldurmasi yukarida. Bu ise PROJEKSIYONUN (Activity akisi,
# Graph, board) gecmis derinligi -- `make rebuild` bunu okur. Ayri olmalari
# sart: radar cift uretir (kare buyur -> judge kotasi), projeksiyon duz liste
# yazar (dogrusal). Ayni sayiyi paylastiklarinda akis 5 haftalik gecmisi
# kaybediyordu (#280).
GITHUB_HISTORY_LIMIT=500
# Backend frontend'i KENDISI servis etsin mi (tek surecli masaustu paketi icin).
# ACIK bayrak, otomatik tespit DEGIL: "dist/ varsa mount et" davranisi
# uygulamanin yollarini "birinin npm run build calistirip calistirmadigina"
# baglıyordu (CI'da 404, gelistirici makinesinde SPA). Docker compose'da
# frontend AYRI servis, masaustu paketinde launcher kendi mount'unu yapiyor —
# bu yuzden varsayilan KAPALI.
ENSEMBLE_SERVE_FRONTEND=false
# 429'da sunucunun dayattigi `retryDelay`'e uyariz, ama INSANIN BEKLEDIGI
# istekte bu sinirla kirpilir. Olculdu: Gemini generate kotasi GUNDE 20;
# tukendiginde 23 sn "bekle" diyor ama pencere YARIN aciliyor -> beklemek
# hicbir sey kazandirmiyor, /radar 66.7 sn suruyordu. Toplu isler (`make
# rebuild`) bunu kendiliginden yukseltir (embed kotasi DAKIKALIK, orada
# beklemek ise yarar).
GEMINI_RETRY_AFTER_CAP_S=10
# Webhook (kayıtta aktif; canlı alıcı S3 #62 — geçici hedef smee kanalı, D-35)
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PROXY_URL=

# Kullanıcı girişi (#79 daraltılmış dilim) — GitHub App kullanıcı-yetkilendirme
# akışı + imzalı çerez oturumu. ÜÇÜ DE boş bırakılırsa uygulama HİÇBİR ŞEKİLDE
# kapanmaz: /auth/config {"enabled": false} döner, /auth/login 503 verir,
# radar/board/scope/query gibi mevcut uçlar ETKİLENMEZ (giriş yalnızca "kim
# olduğunu göster" katmanıdır). access_token BURADA SAKLANMAZ — yalnız
# callback içinde /user çağrısı için kullanılır, sonra atılır.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Oturum çerezini imzalayan HMAC anahtarı (rastgele, uzun bir dize üret —
# örn. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
AUTH_SESSION_SECRET=
# callback başarıyla bittiğinde tarayıcının döneceği yer (frontend rotası).
# "/" artık kimliksiz Landing sayfası (#260) — girişten sonra uygulamaya dönsün.
# MUTLAK URL OLMAK ZORUNDA (şema+host dahil, örn. https://app.example.com/radar)
# — GÖRELİ BİR YOL YAZMA ("/radar" gibi): callback API origin'inde
# (api.<domain>) çalışır, RedirectResponse'a göreli bir yol verilirse
# tarayıcı onu FRONTEND'e değil O ANKİ (api) origin'ine karşı çözer.
# Üretimde tam bu yaşandı (#258): kod varsayılanı göreli idi, giriş
# "başarılı" görünüyordu (302 döndü) ama kullanıcı sessizce
# `https://api.recommend2me.com/radar`'a (404, sayfa yok) düşüyordu.
# Bugün üretimde kullanılan gerçek (mutlak) değer:
#   AUTH_POST_LOGIN_URL=https://recommend2me.com/radar
# config.py artık göreli bir değeri açılışta REDDEDİYOR (fail-closed,
# CORS_ORIGINS "*" reddiyle AYNI desen) — burada boş bırakırsan kod-içi
# yerel varsayılan (http://localhost:5173/radar) geçerli olur.
AUTH_POST_LOGIN_URL=http://localhost:5173/radar
# Çerez Domain'i — paylaşılan üst alan adından türetilir (örn.
# ".ensemble-demo.com") ki api.<domain> ve app.<domain> aynı çerezi
# paylaşabilsin; yerelde BOŞ bırak (Domain set edilmez, localhost çalışır).
AUTH_COOKIE_DOMAIN=

# Radar eşikleri (#151, kalibre: #18) — 0.0/0.0 kalibrasyon SONUCU, placeholder
# değil: sweep (#29, eval/sweep_results.json) 60 kombinasyonun hiçbirinde FP
# eklemeden recall kazandırmıyor — mevcut korpuste FP'yi engelleyen gate/judge
# katmanı, jaccard/similarity değil. Detay + şerhler: eval/kalibrasyon-raporu.md
RADAR_WINDOW_DAYS=14
RADAR_MIN_JACCARD=0.0
RADAR_MIN_SIMILARITY=0.0

# Store (local: sqlite dosya yolu · hosted: postgres dsn)
DATABASE_URL=

# Kalıcı judge yargı TTL'si, gün (#264) — varsayılan 7: çok kısa olursa
# #259'un restart-maliyeti-sıfır amacı kaybolur, çok uzun olursa prompt/model
# değişikliği sessizce sonsuza dek gizlenir. Gerekçe: config.py::Settings.
VERDICT_TTL_DAYS=7

# Frontend (Vite) — backend base URL
VITE_API_BASE_URL=http://localhost:8000
# Mock modu (#21) — yalnız "1" kabul edilir: frontend fixture verisiyle çalışır
# (UI'da "Örnek veri" rozeti görünür); başka değer açılışta net hata verir
VITE_MOCK=

# CORS allowlist (virgüllü, #45) — asla "*". Boş bırakma; set etmezsen local
# varsayılanları geçerli: http://localhost:5173 + http://127.0.0.1:5173
# Hosted örneği:
# CORS_ORIGINS=https://ensemble-demo.vercel.app
