# deploy/.env.production.example — uretim ortam degiskenleri SABLONU (D-46)
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# Bu dosyada GERCEK DEGER YOK ve olmayacak. `.env.production` .gitignore'daki
# `.env.*.local` desenine UYMAZ — commit'lemeden once kok .gitignore'a
# `deploy/.env.production` satirini ekle (bkz. riskler).
#
# Kullanimi (ikisi de gerekli, farkli mekanizmalar):
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#   --env-file : compose YAML'inin icindeki ${...} yerlerini doldurur
#   env_file:  : degiskenleri KONTEYNERIN icine enjekte eder
#
# =============================================================================
# !!! EN ONEMLI KURAL: BOS DEGER, "TANIMSIZ" DEMEK DEGILDIR !!!
# =============================================================================
# `env_file` bir `ANAHTAR=` satirini konteynere BOS STRING olarak gecirir;
# pydantic-settings icin bu "verilmis bir deger"dir ve kod-ici varsayilani EZER.
# Olculmus sonuclari (config.py okunarak):
#   OLLAMA_BASE_URL=          -> validator loopback bekliyor, "" gecmez
#                                -> ValidationError -> UYGULAMA HIC ACILMAZ
#   ENSEMBLE_MODE= / LLM_PROVIDER=  -> Literal ihlali -> ACILMAZ
#   GEMINI_EMBEDDING_DIMENSIONS= / RADAR_* / DEMO_* (int/float/bool) -> ACILMAZ
#   DATABASE_URL=             -> "Could not parse SQLAlchemy URL" (runbook
#                                §2'deki "tuzak kutusu" ile ayni hata)
#   CORS_ORIGINS=             -> allowlist [] olur -> her tarayici istegi bloke
# KURAL: kullanmadigin her anahtari BOS BIRAKMA, satirin basina `#` koy.
# Asagida varsayilani kabul edilen her sey zaten yorumlu birakildi.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) Compose-seviyesi (config.py'de YOK — yalnizca docker-compose.prod.yml okur)
# -----------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# NOT: DATABASE_URL BURADA SET EDILMEZ. docker-compose.prod.yml onu yukaridaki
# uc degerden ve konteyner ag adindan (`db`) turetir:
#   postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Buraya da yazarsan iki kaynak olur ve birbirinden kayar (compose'un
# `environment:` blogu `env_file:`i ezdigi icin buradaki sessizce yok sayilir).


# -----------------------------------------------------------------------------
# 2) Calisma modu
# -----------------------------------------------------------------------------
# ENSEMBLE_MODE: docker-compose.prod.yml `hosted` olarak zaten set ediyor
# (environment: blogu env_file'i ezer). Burada tekrar YAZMA.
# ENSEMBLE_MODE=hosted

# gemini | ollama. Sunucuda Ollama KURULU DEGIL -> gemini kalir.
# Kod varsayilani zaten gemini; satiri acmana gerek yok.
# LLM_PROVIDER=gemini


# -----------------------------------------------------------------------------
# 3) CORS (#45) — ZORUNLU
# -----------------------------------------------------------------------------
# Virgullu tek satir. ASLA "*" (config acilista reddeder).
# = frontend'in Vercel prod origin'i. A2 cift-yon kilidi: bu deger degisirse
# Vercel'deki VITE_API_BASE_URL de AYNI pencerede degisir.
CORS_ORIGINS=https://recommend2me.com
# NOT: yalniz apex listelendi. Vercel'de `www` ayri bir origin olarak SERVIS
# edilirse (redirect DEGIL) onu da virgulle ekle: https://www.recommend2me.com


# -----------------------------------------------------------------------------
# 4) Gemini (embeddings + judge)
# -----------------------------------------------------------------------------
# Bos/eksikse engine FakeJudgeAdapter'a duser -> /health `gemini: "missing"`.
# Canli demoda ISTENMEZ.
GEMINI_API_KEY=

# Asagidakilerin hepsinin kod-ici varsayilani var; yalniz override gerekince ac.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768      # vector(N) migration'iyla HIZALI olmali
# GEMINI_TIMEOUT_S=10
# GEMINI_MAX_RETRIES=3


# -----------------------------------------------------------------------------
# 5) Ollama — bu sunucuda KULLANILMIYOR
# -----------------------------------------------------------------------------
# Ollama kurulu degil. Bu satirlarin HICBIRINI acma; ozellikle
# `OLLAMA_BASE_URL=` bos birakilirsa uygulama HIC ACILMAZ (loopback validator).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_DIMENSIONS=768
# OLLAMA_TIMEOUT_S=60
# OLLAMA_MAX_RETRIES=2


# -----------------------------------------------------------------------------
# 6) GitHub App (makine-auth · ingest · webhook)
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# PEM ICERIGI (dosya yolu DEGIL). Konteynerde mount'lu .pem yok.
# Cozumleme sirasi (config.py, kontrat Ek A/A3): once _PATH, o yoksa bu alan.
# Cok satirli deger: env dosyasi formatinda cift tirnak icinde tek satira
# indirgenmis \n'lerle yazilir; degeri BU DOSYAYA yapistirma, yalniz
# `.env.production` kopyasina.
GITHUB_APP_PRIVATE_KEY=

# Yalniz-local (gelistiricinin diskindeki .pem). Uretimde BOS BIRAKMA -> ACMA.
# GITHUB_APP_PRIVATE_KEY_PATH=

# X-Hub-Signature-256 dogrulamasi. Bos ise webhook alicisi 503 doner
# (dogrulanamayan webhook kabul edilmez). Go-live'da ROTATE edilmis yeni
# bir deger kullanilir ve hicbir kanalda paylasilmaz.
GITHUB_WEBHOOK_SECRET=

# Varsayilanlari var; yalniz override gerekince ac.
# GITHUB_DEFAULT_BRANCH=main
# GITHUB_BACKFILL_LIMIT=50

# Yalniz-local (smee kanali). Uretimde webhook dogrudan
# https://api.recommend2me.com/webhooks/github adresine gelir  <-- `/webhook` DEGIL.
# GITHUB_WEBHOOK_PROXY_URL=


# -----------------------------------------------------------------------------
# 7) Radar esikleri (#151 · kalibrasyon #18)
# -----------------------------------------------------------------------------
# 0.0/0.0 KALIBRASYON SONUCUDUR, placeholder degil (eval/kalibrasyon-raporu.md).
# Kod varsayilanlari kanonik — dokunma.
# RADAR_WINDOW_DAYS=14
# RADAR_MIN_JACCARD=0.0
# RADAR_MIN_SIMILARITY=0.0


# -----------------------------------------------------------------------------
# 8) Hosted demo sertlestirme (#63) — VARSAYILAN KAPALI
# -----------------------------------------------------------------------------
# Public demo aciyorsan `true` yap. FAIL-CLOSED: true iken GITHUB_REPO_OWNER ve
# GITHUB_REPO_NAME zorunludur; eksikse uygulama HIC acilmaz. Bu hata
# docker-compose.prod.yml'de once `migrate` servisinde patlar (alembic env.py da
# get_settings() cagirir) ve api hic baslamaz — istenen davranis.
# Bu blogun etkin olmasi Caddy tarafindaki X-Forwarded-For duzeltmesine BAGLI
# (bkz. deploy/caddy/ensemble.caddy) — aksi halde per-IP kapaklar atlatilabilir.
# DEMO_MODE=false

# Hepsinin kod-ici varsayilani var; yalniz override gerekince ac.
# DEMO_RATE_WINDOW_S=60
# DEMO_AI_RATE_LIMIT=10        # IP basina — /query, /scope/check
# DEMO_AI_GLOBAL_LIMIT=60      # tum IP'ler toplami — asil fatura tavani
# DEMO_RATE_LIMIT=120          # IP basina — diger (poll'lanan) yollar
# DEMO_CACHE_TTL_S=900
# DEMO_CACHE_MAX_ENTRIES=1024


# -----------------------------------------------------------------------------
# 9) BU DOSYAYA AIT OLMAYANLAR (kasten yok — nerede yasadiklari)
# -----------------------------------------------------------------------------
# PORT               -> docker-compose.prod.yml `environment:` ("8000")
# API_DOMAIN         -> deploy/caddy/ensemble.caddy icinde SABIT yazili
#                       (api.recommend2me.com) — ayri env-degiskeni/systemd
#                       drop-in enjeksiyonu YOK (alan adi artik belli).
# VITE_API_BASE_URL  -> Vercel proje env'i (build-time gomulur)
# VITE_MOCK          -> yalniz-local; Vercel'de TANIMLAMA (#188 build guard'i
#                       prod build'i kendi kirar)
# FLY_API_TOKEN      -> Fly CD'sine ait; bu VDS topolojisinde kullanilmaz
#                       (fly.toml + Fly deploy hedefi D-46 ile kaldirildi)